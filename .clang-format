---
Language: Cpp
# Microsoft 风格：4 空格缩进、大括号单独占一行
BasedOnStyle: Microsoft
Standard: c++20
ColumnLimit: 100

# int* p 而不是 int *p
PointerAlignment: Left

# switch 里的 case 缩进一级（和 .editorconfig 的 csharp_indent_switch_labels 一致）
IndentCaseLabels: true

# 类里面很短的 getter 允许写成一行：int size() const { return n_; }
AllowShortFunctionsOnASingleLine: Inline

LineEnding: LF
InsertNewlineAtEOF: true

# ---------- #include  ----------
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # 1. 标准库：<vector>、<string_view>、<cstdint>
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  # 3. 本项目头文件："gpia/..."
  - Regex: '^"gpia/'
    Priority: 3
  # 2. 其余都算第三方：<gtest/gtest.h>、<nlohmann/json.hpp>
  - Regex: '.*'
    Priority: 2
