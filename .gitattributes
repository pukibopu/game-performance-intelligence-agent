# 默认：文本文件在仓库中统一存为 LF
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Unity YAML 但禁止自动合并（合并错了会悄悄损坏场景）
*.unity   text eol=lf merge=binary
*.prefab  text eol=lf merge=binary
*.asset   text eol=lf merge=binary
*.mat     text eol=lf merge=binary
*.meta    text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.tga   binary
*.psd   binary
*.fbx   binary
*.dll   binary
*.exe   binary
*.pdf   binary

# 数据样本按字节原样保存
schemas/examples/*.csv -text
datasets/**/*.csv      -text
core/tests/testdata/**/*.csv -text
